rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['title', 'start']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.start is string && data.start.size() > 0 && data.start.size() <= 50 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
        (!('end' in data) || (data.end is string && data.end.size() <= 50)) &&
        (!('hasTime' in data) || data.hasTime is bool) &&
        (!('color' in data) || (data.color is string && data.color.size() <= 20)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
        (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 50));
    }

    function isValidScoutAccount(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
        (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 256)) &&
        (!('salt' in data) || (data.salt is string && data.salt.size() <= 128)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('authProvider' in data) || (data.authProvider is string && data.authProvider.size() <= 50)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
        (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 50));
    }

    function isValidUserProgress(data) {
      return data.keys().hasAll(['uid']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isValidId(eventId) && isValidEvent(incoming());
      allow delete: if isValidId(eventId);
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId);
    }

    match /scout_accounts/{accountId} {
      allow read: if true;
      allow create, update: if isValidId(accountId) && isValidScoutAccount(incoming());
      allow delete: if isValidId(accountId);
    }

    match /user_progress/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUserProgress(incoming());
      allow delete: if isValidId(userId);
    }
  }
}
